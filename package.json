{
  "name": "agent-wrapped",
  "version": "0.0.0",
  "private": true,
  "description": "The funniest moments, catchphrases and plot twists from your AI coding sessions.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "test:quote": "npm run build && node --test test/quoteScorer.test.mjs",
    "test:session": "npm run build && node --test test/sessionAnalyzer.test.mjs",
    "test:catchphrase": "npm run build && node --test test/catchphraseClusterer.test.mjs",
    "test:boomerang": "npm run build && node --test test/boomerangDetector.test.mjs",
    "test:event": "npm run build && node --test test/eventExtractor.test.mjs",
    "test:graph": "npm run build && node --test test/momentGraph.test.mjs",
    "test:moment-builder": "npm run build && node --test test/momentBuilder.test.mjs",
    "test:moment-ranker": "npm run build && node --test test/momentRanker.test.mjs",
    "test:moments": "npm run build && node --test test/momentBuilder.test.mjs test/momentRanker.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
